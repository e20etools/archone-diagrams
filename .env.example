# Copy to .env.local for local development, or add the same names in the hosting settings.
# None of the server values are sent to the browser. Without them the app still works:
# text drafts use built-in rules, and drafting from an image is switched off.

# One of: anthropic | openai | lovable | openai-compatible
AI_PROVIDER=
# The provider's API key
AI_API_KEY=
# The model id. Optional for anthropic; required for the others.
AI_MODEL=
# Only for openai-compatible providers, for example https://example.com/v1
AI_BASE_URL=

# Optional. When set, the app asks each person for this code (Settings) before it drafts with AI.
# Use it on a public address so that strangers cannot spend your AI budget.
AI_ACCESS_CODE=

# Optional. Only when the AI function runs on another domain than the app
# (a Supabase or Lovable Cloud Edge Function): the app's address, for example https://my-app.lovable.app
AI_ALLOWED_ORIGIN=

# Optional, read at build time, safe to expose. Only when the AI function runs on another domain:
# the full address of that function.
VITE_AI_ENDPOINT=

# --- Hosted mode (phase 2): accounts, shared workspaces, real-time editing ---
# Both are read at build time and are safe to expose. Leave empty to run in the browser only.
# Run supabase/migrations/*.sql on the project first (see README).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# With hosted mode on, /api/ai drafts only for signed-in people. Set to false to keep it open.
AI_REQUIRE_SIGN_IN=
