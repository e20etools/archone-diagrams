{
  "name": "archone-diagrams",
  "private": true,
  "version": "0.1.0",
  "description": "Model-based IT architecture diagram tool with AI drafting and human review.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/build-api.mjs --check",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-check.mjs",
    "test:browser:cloud": "node scripts/browser-check-cloud.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@supabase/supabase-js": "^2.119.0",
    "@xyflow/react": "^12.12.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
